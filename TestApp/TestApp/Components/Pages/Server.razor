@page "/server"
@rendermode InteractiveServer
@using TestApp.VB

<MainView Title="Bob"/>

<TableTemplate Items="pets" Context="pet">
    <TableHeader>
        <th>ID</th>
        <th>Name</th>
    </TableHeader>
    <RowTemplate>
        <td>@pet.PetId</td>
        <td>@pet.Name</td>
    </RowTemplate>
</TableTemplate>

@code {

    private List<Pet> pets =
    [
        new() { PetId = 2, Name = "Mr. Bigglesworth" },
        new() { PetId = 4, Name = "Salem Saberhagen" },
        new() { PetId = 7, Name = "K-9" }
    ];

}